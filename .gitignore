
.DS_Store

scripts/markdown/

# Pre-refetch snapshots of scripts/markdown/. The bulk copy is local-only; the
# sha256 manifest beside it is small and tracked so drift is reviewable in git.
scripts/baseline/*/markdown/

**/cdk.out/
**/dist/
**/node_modules/

infrastructure/parameters.json



infrastructure/cdk.context.json

# The keri-chat MCP server ships to plugin installs as a pre-bundled artifact.
# The plugin cache is a git clone with no node_modules and no build step, so
# this one dist/ is tracked deliberately. Rebuild and commit it when src/ changes.
!mcp-servers/keri-chat/dist/

# Only the bundle is tracked — tsc/​esbuild side artefacts are not.
mcp-servers/keri-chat/dist/*.d.ts
mcp-servers/keri-chat/dist/*.map
