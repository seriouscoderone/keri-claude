{
  "name": "keri-chat-infrastructure",
  "version": "0.1.0",
  "bin": {
    "app": "bin/app.ts"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "typecheck:lambda": "tsc -p lambda/tsconfig.json",
    "test": "vitest run",
    "cdk": "cdk",
    "synth": "cdk synth KeriChat",
    "deploy": "cdk deploy KeriChat",
    "deploy:all": "cdk deploy --all",
    "publish:template": "bash scripts/publish-template.sh keri-host-chat-stack us-east-1"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-agent": "^3.1100.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1100.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1100.0",
    "@aws-sdk/client-rds-data": "^3.1100.0",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.180.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.7.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "aws-cdk-lib": "^2.180.0",
    "cdk-bootstrapless-synthesizer": "^2.3.2",
    "constructs": "^10.4.0",
    "zod": "^3.24.0"
  }
}
